{
  "name": "@outreach/core",
  "version": "0.1.0",
  "private": true,
  "description": "The platform's engine: data model, rules, workflow interpreter, campaigns, analytics. Pure TypeScript, shared by apps/platform, the API and the agent.",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "require": "./dist/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
