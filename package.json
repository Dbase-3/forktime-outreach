{
  "name": "forktime-outreach",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "setup:prod": "node scripts/setup-env.mjs --prod",
    "dev:agent:prod": "pnpm --filter @outreach/agent dev:prod",
    "deploy:agent": "pnpm --filter @outreach/agent run deploy",
    "db": "pnpm --filter @outreach/web db",
    "dev:web": "pnpm --filter @outreach/web dev",
    "dev:agent": "pnpm --filter @outreach/agent dev",
    "dev:platform": "pnpm --filter @outreach/platform dev",
    "build:platform": "pnpm --filter @outreach/platform build",
    "build": "pnpm --filter @outreach/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @outreach/web typecheck",
    "lint": "pnpm --filter @outreach/web lint"
  }
}
