# apps/api local settings. Copy to .env (git-ignored).
PORT=4300
NODE_ENV=development
# Local MongoDB on 27018: `pnpm --filter @outreach/api db` (no Docker needed), or a docker container
MONGODB_URI=mongodb://localhost:27018/forktime_platform?directConnection=true
# Redis for BullMQ jobs; db index and prefix keep it apart from forktime-core's dev Redis
REDIS_URL=redis://localhost:6379/3
REDIS_PREFIX=platform
# The front end's address (links in sign-in emails, cookie security)
APP_URL=http://localhost:3200
# Email (Resend). Without a key, sign-in codes are printed to the log.
RESEND_API_KEY=
EMAIL_FROM="Forktime <hello@forktime.ai>"
# Development only: also accept this sign-in code. Refused when NODE_ENV=production.
DEV_LOGIN_CODE=000000
# Without Redis (local dev): run jobs straight away inside the request.
JOBS_INLINE=false
# Run the job workers inside the API process (dev); production runs `pnpm worker` separately.
WORKER_IN_PROCESS=true
