{
  "name": "@outreach/api",
  "version": "0.1.0",
  "private": true,
  "description": "The platform's backend: NestJS + MongoDB + Redis (BullMQ). See docs/PLATFORM_ROADMAP.md.",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "prebuild": "pnpm --filter @outreach/core build",
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @outreach/core build",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "pretest": "pnpm --filter @outreach/core build",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db": "node scripts/dev-db.js"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "jest": "^30",
    "mongodb-memory-server-core": "^10.1.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@outreach/core": "workspace:^",
    "bullmq": "^6.7.10",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.1.0",
    "mongoose": "^8.19.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6",
    "rxjs": "^7.8.1",
    "zod": "^4"
  }
}
